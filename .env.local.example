# ─────────────────────────────────────────────────────────────────────────────
# Verafye — Required Environment Variables
# Copy this file to .env.local before running locally or deploying.
# ─────────────────────────────────────────────────────────────────────────────

# Lead capture endpoint for PDF gated download form.
# In production this must be set to the live Verafye API endpoint.
# If unset, PdfDownloadModal.js falls back to:
#   https://dashboard.verafye.com/api/external-email/send
NEXT_PUBLIC_VERAFYE_LEAD_CAPTURE_ENDPOINT=https://dashboard.verafye.com/api/external-email/send
